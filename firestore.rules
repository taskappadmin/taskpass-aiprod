rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own profile and private application data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default. Add narrowly scoped collaborative rules
    // only after defining the authorization model for those collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
